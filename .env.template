# ============================================================
# SentinelX Enterprise SIEM - Environment Configuration
# ============================================================

# --- App Settings ---
ENV=production
LOG_LEVEL=INFO

# --- Supabase Configuration ---
# Found in Supabase -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret-for-auth-verification

# --- Infrastructure ---
# Ports are pre-configured to 91xx to avoid conflicts
KAFKA_BROKERS=kafka:9092
REDIS_URL=redis://redis:6379/0

# --- ClickHouse ---
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=sentinelx

# --- AI Integration ---
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o

# --- GeoIP ---
# Path inside the container (mounted via volume)
GEOIP_DB_PATH=/app/data/GeoLite2-City.mmdb

# --- Frontend (NEXT.JS) ---
NEXT_PUBLIC_API_URL=http://localhost:9100
NEXT_PUBLIC_WS_URL=ws://localhost:9106
# MAPBOX_PUBLIC_TOKEN=pk.eyJ1Ijoic2VudGluZWx4..."
