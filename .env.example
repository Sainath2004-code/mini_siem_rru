# =============================================================
# SentinelX SIEM — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit your .env file to source control
# =============================================================

# ---- App ----
ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-long-random-secret

# ---- Supabase ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- Kafka ----
KAFKA_BROKERS=kafka:9092
KAFKA_CONSUMER_GROUP_PARSER=parser-group
KAFKA_CONSUMER_GROUP_DETECTION=detection-group

# ---- ClickHouse ----
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=sentinelx

# ---- AI Service ----
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o
AI_PROVIDER=openai   # openai | gemini | ollama

# ---- Alert Integrations ----
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
PAGERDUTY_INTEGRATION_KEY=your-pagerduty-key
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@yourdomain.com
SMTP_PASSWORD=your-smtp-password

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_WS_URL=ws://localhost:8006
